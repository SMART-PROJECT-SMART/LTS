{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "telemetry-consumer-group",
    "TopicPrefix": "telemetry-tailId-",
    "SubscriptionCheckIntervalMs": 5000,
    "EnableAutoCommit": false,
    "AutoOffsetReset": "Earliest"
  },
  "Processing": {
    "SubscriptionCheckIntervalMs": 5000,
    "MaxRetries": 3,
    "RetryDelayMs": 1000
  },
  "Scheduler": {
    "ConsumeIntervalSeconds": 1,
    "BroadcastIntervalSeconds": 3
  },
  "AllowedHosts": "*"
}
