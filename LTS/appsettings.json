{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupIdPrefix": "lts-telemetry",
    "TopicPrefix": "telemetry-tailId-",
    "SubscriptionCheckIntervalMs": 5000,
    "AutoOffsetReset": "Latest"
  },
  "Simulator": {
    "BaseUrl": "http://localhost:5023"
  },
  "Processing": {
    "SubscriptionCheckIntervalMs": 5000,
    "MaxRetries": 3,
    "RetryDelayMs": 1000
  },
  "Scheduler": {
    "ConsumeIntervalSeconds": 1,
    "BroadcastIntervalSeconds": 1
  },
  "AllowedHosts": "*"
}
